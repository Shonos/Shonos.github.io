{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
    "maxNodeModuleJsDepth": 0,
  "include": ["src/**/*.js", "src/**/*.d.ts"],
  "exclude": ["node_modules/**", "dist/**", "tests/**", "playwright-report/**", "test-results/**"]
}
