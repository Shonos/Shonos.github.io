{
  "name": "shaunalonzo-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-build.js",
    "preview": "vite preview --host 127.0.0.1",
    "prod": "npm run build && npm run preview",
    "preview:pages": "node scripts/preview-pages.js",
    "validate:content": "node scripts/validate-content.js",
    "lint": "eslint .",
    "typecheck": "tsc --project jsconfig.json",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/html-minifier-terser": "7.0.2",
    "@types/node": "24.13.6",
    "ajv": "8.20.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "handlebars": "4.7.9",
    "html-minifier-terser": "7.2.0",
    "parse5": "8.0.0",
    "terser": "5.51.2",
    "typescript": "5.8.3",
    "vite": "8.3.1"
  }
}
