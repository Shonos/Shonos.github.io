        {
          "id": "019ece26-9bd0-768b-b4bf-e4bcf4506ba0",
          "hidden": false,
          "name": ".NET HTTP Extensions for Domain",
          "period": "2026",
          "website": {
            "url": "",
            "label": "",
            "inlineLink": false
          },
          "description": "<p>Developed a standardized .NET 8 HTTP client library using <code>IHttpClientFactory</code> and pure DI to streamline secure, high-performance service communication. Integrated automated OAuth2 token injection and architected a configurable resilience pipeline (circuit breakers, timeouts, and retries) using <code>Microsoft.Extensions.Http.Resilience</code> while optimizing network efficiency via <code>SocketsHttpHandler</code> connection pooling.</p>"
        },
        {
          "id": "019ece2a-1747-76ec-9563-c55933ef9c45",
          "hidden": false,
          "name": ".NET Fluent Cache Wrapper Library",
          "period": "2024",
          "website": {
            "url": "",
            "label": "",
            "inlineLink": false
          },
          "description": "<p>Developed a .NET library for Domain devs implementing a fluent API wrapper for <code>IDistributedCache</code> to standardize and simplify distributed caching strategies. Engineered chainable configurations for automated cache-miss data fetching, conditional storage policies, and flexible expiration windows (absolute and sliding), significantly reducing boilerplate code and improving application maintainability.</p>"
        }
      ]
    },
